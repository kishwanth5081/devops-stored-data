[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
x509_extensions = v3_req

[dn]
C = US
ST = California
L = San Francisco
O = DevOps Stored Data Operations
OU = Security Architecture
CN = localhost

[v3_req]
subjectAltName = @alt_names
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = localhost
DNS.2 = *.localhost
DNS.3 = devops.internal
DNS.4 = *.devops.internal
DNS.5 = devops.example.com
DNS.6 = *.onrender.com
DNS.7 = *.trycloudflare.com
IP.1 = 127.0.0.1
IP.2 = 192.168.0.132
IP.3 = 192.168.0.104
IP.4 = 0.0.0.0
IP.5 = 172.21.128.1
IP.6 = 172.30.224.1
IP.7 = 192.168.56.1
