# ==============================================================================
# DevOps Stored Data - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication (Replace with a strong 64+ char random string in production)
JWT_SECRET=devops-stored-data-production-super-secret-jwt-key-2026-replace-me
JWT_EXPIRES_IN=7d

# Database & Storage Paths
DB_PATH=/app/backend/data/devops_stored.sqlite
UPLOADS_DIR=/app/backend/uploads

# Maximum Upload File Size (50MB in bytes)
MAX_FILE_SIZE=52428800

# CORS Whitelist (Your custom domain)
CORS_ORIGIN=https://devops.example.com
